FROM pubrepo.guance.com/base/ubuntu:22.04 AS builder

ARG http_proxy
ARG https_proxy
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG TARGETARCH

ENV DEBIAN_FRONTEND=noninteractive

RUN set -eux; \
    native_arch="$(dpkg --print-architecture)"; \
    case "${native_arch}" in \
      amd64) \
        foreign_arch=arm64; \
        native_mirror=http://mirrors.aliyun.com/ubuntu; \
        foreign_mirror=http://mirrors.aliyun.com/ubuntu-ports; \
        cross_compilers="gcc-aarch64-linux-gnu g++-aarch64-linux-gnu"; \
        cross_sysroot_pkgs="libc6-dev-arm64-cross linux-libc-dev-arm64-cross"; \
        ;; \
      arm64) \
        foreign_arch=amd64; \
        native_mirror=http://mirrors.aliyun.com/ubuntu-ports; \
        foreign_mirror=http://mirrors.aliyun.com/ubuntu; \
        cross_compilers="gcc-x86-64-linux-gnu g++-x86-64-linux-gnu"; \
        cross_sysroot_pkgs="libc6-dev-amd64-cross linux-libc-dev-amd64-cross"; \
        ;; \
      *) echo "unsupported native arch: ${native_arch}"; exit 1 ;; \
    esac; \
    dpkg --add-architecture "${foreign_arch}"; \
    printf '%s\n' \
      "deb [arch=${native_arch}] ${native_mirror} jammy main restricted universe multiverse" \
      "deb [arch=${native_arch}] ${native_mirror} jammy-updates main restricted universe multiverse" \
      "deb [arch=${native_arch}] ${native_mirror} jammy-backports main restricted universe multiverse" \
      "deb [arch=${native_arch}] ${native_mirror} jammy-security main restricted universe multiverse" \
      "" \
      "deb [arch=${foreign_arch}] ${foreign_mirror} jammy main restricted universe multiverse" \
      "deb [arch=${foreign_arch}] ${foreign_mirror} jammy-updates main restricted universe multiverse" \
      "deb [arch=${foreign_arch}] ${foreign_mirror} jammy-backports main restricted universe multiverse" \
      "deb [arch=${foreign_arch}] ${foreign_mirror} jammy-security main restricted universe multiverse" \
      > /etc/apt/sources.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      clang \
      curl \
      make \
      pkg-config \
      llvm \
      gcc \
      g++ \
      linux-headers-generic \
      ${cross_compilers} \
      ${cross_sysroot_pkgs}; \
    case "${native_arch}" in \
      amd64) foreign_triplet=aarch64-linux-gnu ;; \
      arm64) foreign_triplet=x86_64-linux-gnu ;; \
    esac; \
    command -v gcc; \
    command -v g++; \
    command -v "${foreign_triplet}-gcc"; \
    command -v "${foreign_triplet}-g++"; \
    native_hdr="$(find /usr/src -maxdepth 1 -type d -name 'linux-headers-*-generic' | sort | tail -n 1)"; \
    test -n "${native_hdr}"; \
    ln -sfn "${native_hdr}" "/usr/src/linux-headers-${native_arch}"; \
    foreign_hdr_mirror="${foreign_mirror}"; \
    ver="$(basename "${native_hdr}" | sed 's/^linux-headers-//; s/-generic$//')"; \
    packages_gz="/tmp/${foreign_arch}-Packages.gz"; \
    curl -fsSL --retry 5 --retry-delay 2 --retry-all-errors -o "${packages_gz}" "${foreign_hdr_mirror}/dists/jammy-updates/main/binary-${foreign_arch}/Packages.gz"; \
    hdr_pkg_name="linux-headers-${ver}-generic"; \
    hdr_pkg="$(gzip -dc "${packages_gz}" | awk -v pkg="${hdr_pkg_name}" '$1=="Package:" {found=($2==pkg); next} found && $1=="Filename:" {print $2; exit}')"; \
    common_pkg_name="$(gzip -dc "${packages_gz}" | awk -v pkg="${hdr_pkg_name}" '\
      $1=="Package:" {found=($2==pkg); next} \
      found && $1=="Depends:" { \
        deps=substr($0, index($0, $2)); \
        n=split(deps, items, ", "); \
        for (i=1; i<=n; i++) { \
          dep=items[i]; \
          sub(/ .*/, "", dep); \
          if (dep ~ /^linux-.*headers-[0-9]/) { print dep; exit } \
        } \
      }' \
    )"; \
    common_pkg="$(gzip -dc "${packages_gz}" | awk -v pkg="${common_pkg_name}" '$1=="Package:" {found=($2==pkg); next} found && $1=="Filename:" {print $2; exit}')"; \
    test -n "${hdr_pkg}" && test -n "${common_pkg_name}" && test -n "${common_pkg}"; \
    curl -fsSL --retry 5 --retry-delay 2 --retry-all-errors -o "/tmp/${foreign_arch}-headers.deb" "${foreign_hdr_mirror}/${hdr_pkg}"; \
    curl -fsSL --retry 5 --retry-delay 2 --retry-all-errors -o "/tmp/${foreign_arch}-headers-common.deb" "${foreign_hdr_mirror}/${common_pkg}"; \
    extract_root="/opt/${foreign_arch}-kheaders"; \
    rm -rf "${extract_root}" && mkdir -p "${extract_root}"; \
    dpkg-deb -x "/tmp/${foreign_arch}-headers.deb" "${extract_root}"; \
    dpkg-deb -x "/tmp/${foreign_arch}-headers-common.deb" "${extract_root}"; \
    test -d "${extract_root}/usr/src/linux-headers-${ver}-generic"; \
    ln -sfn "${extract_root}/usr/src/linux-headers-${ver}-generic" "/usr/src/linux-headers-${foreign_arch}"; \
    rm -rf \
      /var/lib/apt/lists/* \
      /tmp/"${foreign_arch}"-Packages.gz \
      /tmp/"${foreign_arch}"-headers.deb \
      /tmp/"${foreign_arch}"-headers-common.deb \
      /usr/share/doc/* \
      /usr/share/info/* \
      /usr/share/locale/* \
      /usr/share/man/*

RUN ln -sfn /usr/bin/llc /usr/local/bin/llc && \
    ln -sfn /usr/bin/llvm-strip /usr/local/bin/llvm-strip

ARG LEGACY_SYSROOT_DIST=buster
ARG LEGACY_SYSROOT_MIRROR=https://archive.debian.org/debian

RUN set -eux; \
    fetch_pkg() { \
      local packages_gz="$1"; \
      local mirror="$2"; \
      local pkg="$3"; \
      local file; \
      file="$(gzip -dc "${packages_gz}" | awk -v pkg="${pkg}" '$1=="Package:" && $2==pkg {found=1; next} found && $1=="Filename:" {print $2; exit}')"; \
      test -n "${file}"; \
      curl -fsSL --retry 5 --retry-delay 2 --retry-all-errors -o "/tmp/${pkg}.deb" "${mirror}/${file}"; \
    }; \
    for arch in amd64 arm64; do \
      case "${arch}" in \
        amd64) triplet=x86_64-linux-gnu ;; \
        arm64) triplet=aarch64-linux-gnu ;; \
      esac; \
      root="/opt/sysroots/debian10/${arch}"; \
      packages_gz="/tmp/debian10-${arch}-Packages.gz"; \
      curl -fsSL --retry 5 --retry-delay 2 --retry-all-errors -o "${packages_gz}" "${LEGACY_SYSROOT_MIRROR}/dists/${LEGACY_SYSROOT_DIST}/main/binary-${arch}/Packages.gz"; \
      rm -rf "${root}" && mkdir -p "${root}"; \
      for pkg in \
        libc6 libc6-dev linux-libc-dev \
        libsystemd0 libsystemd-dev \
        libaio1 libaio-dev \
        libcap2 liblzma5 libzstd1 liblz4-1 \
        libgcrypt20 libgpg-error0 \
        libgcc1 libstdc++6; do \
        fetch_pkg "${packages_gz}" "${LEGACY_SYSROOT_MIRROR}" "${pkg}"; \
        dpkg-deb -x "/tmp/${pkg}.deb" "${root}"; \
        rm -f "/tmp/${pkg}.deb"; \
      done; \
      find "${root}/lib" "${root}/lib64" "${root}/usr/lib" -type l 2>/dev/null | while read -r link; do \
        target="$(readlink "${link}")"; \
        case "${target}" in \
          /*) \
            rel_target="$(realpath --no-symlinks --relative-to="$(dirname "${link}")" "${root}${target}")"; \
            ln -sfn "${rel_target}" "${link}"; \
            ;; \
        esac; \
      done; \
      find "${root}/usr/lib/${triplet}" -maxdepth 1 -type f -name '*.so' | while read -r script; do \
        if grep -qE '^(GROUP|INPUT)[[:space:]]*[(]' "${script}"; then \
          sed -i 's#\\([[:space:]]*/#\\1=/#g' "${script}"; \
        fi; \
      done; \
      mkdir -p "${root}/usr/lib/${triplet}/pkgconfig" "${root}/usr/share/pkgconfig"; \
      test -f "${root}/usr/lib/${triplet}/pkgconfig/libsystemd.pc"; \
      test -f "${root}/lib/${triplet}/libsystemd.so"; \
      test -f "${root}/usr/lib/${triplet}/libaio.so"; \
      test -f "${root}/usr/lib/${triplet}/libc.so"; \
      test -f "${root}/usr/lib/${triplet}/crt1.o"; \
      test -f "${root}/lib/${triplet}/libc.so.6"; \
      ln -sfn "${root}" "/opt/sysroots/debian10-${arch}"; \
      rm -f "${packages_gz}"; \
    done

ARG GO_VERSION_DEFAULT=1.19.13
ARG GO_VERSION_EBPF=1.26.1
ARG GO_DOWNLOAD_BASE=https://mirrors.aliyun.com/golang
ENV GOPROXY="https://goproxy.cn,direct"

RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    for ver in "${GO_VERSION_DEFAULT}" "${GO_VERSION_EBPF}"; do \
      curl -fsSL --retry 5 --retry-delay 2 --retry-all-errors "${GO_DOWNLOAD_BASE}/go${ver}.linux-${arch}.tar.gz" -o "/tmp/go${ver}.tar.gz"; \
      rm -rf "/usr/local/go${ver}"; \
      mkdir -p "/usr/local/go${ver}"; \
      tar -C /usr/local -xzf "/tmp/go${ver}.tar.gz"; \
      mv /usr/local/go "/usr/local/go${ver}"; \
      rm -f "/tmp/go${ver}.tar.gz"; \
    done; \
    case "${arch}" in \
      arm64) default_go="/usr/local/go${GO_VERSION_DEFAULT}/go" ;; \
      *) default_go="/usr/local/go${GO_VERSION_EBPF}/go" ;; \
    esac; \
    ln -sfn "${default_go}" /usr/local/go-default

ENV GOROOT_119=/usr/local/go${GO_VERSION_DEFAULT}/go
ENV GOROOT_126=/usr/local/go${GO_VERSION_EBPF}/go
ENV GOROOT_DEFAULT=/usr/local/go-default
ENV PATH=/usr/local/go-default/bin:/usr/local/go${GO_VERSION_EBPF}/go/bin:/usr/local/go${GO_VERSION_DEFAULT}/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

WORKDIR /root/go/src/gitlab.jiagouyun.com/cloudcare-tools/datakit

CMD ["bash"]
