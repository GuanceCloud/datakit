FROM pubrepo.guance.com/base/ubuntu:22.04 AS base

ARG TARGETARCH

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# CGO is required for dlopen (runtime loading of libsystemd)
# Note: We don't need libsystemd-dev at build time, only libdl which is included in libc
ENV CGO_ENABLED=1
ENV CGO_CFLAGS="-Wno-undef-prefix"

RUN sed -i 's/\(archive\|security\|ports\).ubuntu.com/mirrors.aliyun.com/' /etc/apt/sources.list \
  && apt-get update && apt-get install -y --no-install-recommends \
  curl gcc libc6-dev libsystemd-dev \
  && rm -rf /var/lib/apt/lists/*

ENV DK_BUILD_GO_VERSION=1.19.12

# Use Chinese mirror for reliable Go downloads
RUN curl -k --retry 5 --retry-delay 5 --retry-max-time 120 -Lo go${DK_BUILD_GO_VERSION}.linux-${TARGETARCH}.tar.gz https://mirrors.aliyun.com/golang/go${DK_BUILD_GO_VERSION}.linux-${TARGETARCH}.tar.gz && \
    rm -rf /usr/local/go && \
    tar -C /usr/local/ -xzf go${DK_BUILD_GO_VERSION}.linux-${TARGETARCH}.tar.gz && \
    rm -rf /usr/local/go${DK_BUILD_GO_VERSION} && \
    mv /usr/local/go /usr/local/go${DK_BUILD_GO_VERSION} && \
    rm go${DK_BUILD_GO_VERSION}.linux-${TARGETARCH}.tar.gz

ENV PATH=$PATH:/usr/local/go${DK_BUILD_GO_VERSION}/bin GOROOT=/usr/local/go${DK_BUILD_GO_VERSION}

RUN mkdir -p /root/go/src/gitlab.jiagouyun.com/cloudcare-tools/
